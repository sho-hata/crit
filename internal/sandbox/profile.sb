;; The seatbelt profile crit's language servers run under (macOS).
;;
;; Paths come in as -D parameters, never spliced into this text:
;;   ROOT          the tree under review
;;   DEP_ROOT      the working tree behind a range-focus worktree (= ROOT without one)
;;   SCRATCH_BASE  the directory holding every server's scratch
;;   SCRATCH       this server's scratch, the one writable directory
;; Each is a resolved path (/private/var, not /var): the kernel matches what
;; symlinks lead to. A parameter left unset makes sandbox-exec refuse the
;; profile.
;;
;; Rules are last-match-wins. The read rules come last and are generated by
;; profile.go: they depend on how the trees, the scratch and the secrets nest.

(version 1)
(deny default)

;; Processes: anything may run except a file from the trees or any scratch,
;; and the same goes for mapping one as native code (dlopen).
(allow process-fork)
(allow process-exec)
(deny process-exec
  (subpath (param "ROOT"))
  (subpath (param "DEP_ROOT"))
  (subpath (param "SCRATCH_BASE")))
(allow file-map-executable)
(deny file-map-executable
  (subpath (param "ROOT"))
  (subpath (param "DEP_ROOT"))
  (subpath (param "SCRATCH_BASE")))
(allow signal (target same-sandbox))

;; Writes: under the scratch, but not the scratch itself. A process that
;; could replace it with a symlink would steer the next spawn's cleanup and
;; write grant to wherever the link points.
(allow file-write* (subpath (param "SCRATCH")))
(deny file-write* (literal (param "SCRATCH")))
(allow file-write-data (literal "/dev/null") (literal "/dev/zero"))
(allow file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/dtracehelper"))

;; System: what the measured servers (gopls, typescript-language-server,
;; pyright, intelephense, terraform-ls) need to answer a hover. No network
;; rule is allowed anywhere, loopback included.
(allow sysctl-read)
(allow ipc-posix-shm)
(allow ipc-posix-sem)
(allow user-preference-read)
(allow iokit-get-properties)
(allow mach-lookup
  (global-name "com.apple.logd")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.FSEvents"))

;; Reads: everything, then the rules profile.go appends.
(allow file-read*)
